{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KytyPS5 Studio community catalog",
  "type": "object",
  "required": ["forks", "patches"],
  "properties": {
    "schema": { "const": 1 },
    "updated": { "type": "string", "pattern": "^\d{4}-\d{2}-\d{2}$" },
    "about": { "type": "string" },
    "forks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "repo", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[\w.-]{1,40}$" },
          "name": { "type": "string", "maxLength": 120 },
          "repo": { "type": "string", "pattern": "^[\w.-]+/[\w.-]+$" },
          "author": { "type": "string" },
          "description": { "type": "string", "maxLength": 1200 },
          "games": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string", "maxLength": 600 },
          "license": { "type": "string" }
        }
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "titleId", "game", "name", "version", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[\w.-]{1,40}$" },
          "titleId": { "type": "string", "pattern": "^[A-Z]{4}\d{5}$" },
          "game": { "type": "string" },
          "gameVersion": { "type": "string" },
          "name": { "type": "string", "maxLength": 120 },
          "author": { "type": "string" },
          "version": { "type": "string" },
          "options": { "type": "integer", "minimum": 0 },
          "file": { "type": "string", "description": "relative path next to catalog.json, e.g. patches/PPSA00000-name.json" },
          "url": { "type": "string", "pattern": "^https://(raw\.githubusercontent\.com|gist\.githubusercontent\.com|github\.com)/" },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "description": { "type": "string", "maxLength": 1000 }
        }
      }
    }
  }
}
